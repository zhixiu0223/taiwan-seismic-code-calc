   "source": [
    "def analyze_with_fallback():\n",
    "    \"\"\"單步分析, Newton失敗時自動嘗試備援演算法, 成功後切回Newton\"\"\"\n",
    "    ok = ops.analyze(1)\n",
    "    if ok != 0:\n",
    "        for algo in [('KrylovNewton',), ('ModifiedNewton','-initial'), ('Broyden',8)]:\n",
    "            ops.algorithm(*algo)\n",
    "            ok = ops.analyze(1)\n",
    "            if ok == 0:\n",
    "                break\n",
    "        ops.algorithm('Newton')\n",
    "    return ok\n",
    "\n",
    "print(\"共用fallback函式定義完成\")"
   ]
  },
