    "beta1, eps_cu = 0.85, 0.003\n",
    "\n",
    "# ============================================================\n",
    "# 修正記錄(VL-11): 這個函式原本把中性軸深度c的量測基準點誤設成\n",
    "# 「最外層鋼筋位置」(用half=16cm當基準, half=核心半邊到形心的距離),\n",
    "# 不是規範定義的「斷面真正物理邊緣」(應該用h/2=20cm)——少算了4cm\n",
    "# 保護層厚度, 導致算出來的Mn系統性偏低。這個瑕疵是在taiwan-seismic-\n",
    "# code-calc repo新建立design_column_PM()時, 拿同一個斷面回頭對答案\n",
    "# 才被發現的: 獨立第三方concreteproperties在同一個Pu=147.6kN軸力點\n",
    "# 算出238.10kN-m, 跟design_column_PM()算出的238.03幾乎完全吻合\n",
    "# (差異0.03%), 反過來確認這裡原本的220.83有瑕疵。\n",
    "# 修正: dist改成從真正的斷面邊緣(hh/2)量起, 不是從half(鋼筋位置)量起。\n",
    "# ============================================================\n",
    "def Mn_strain_compat(Pu_kN):\n",
    "    \"\"\"應變相容法, 跟Case-03.6c同一套邏輯, 用kgf/cm^2傳統單位制\"\"\"\n",
    "    half = h/2*100 - cover*100   # 核心半邊到形心的距離(鋼筋位置), 不是斷面邊緣\n",
    "    edge = h/2*100                # 修正: 斷面真正物理邊緣到形心的距離, c應該從這裡量\n",
    "    As_bar = (rho*(h*100)**2)/8\n",
    "    bar_layers = {half: 3, 0.0: 2, -half: 3}\n",
    "    fc_cgs, fy_cgs, Es_cgs = 280.0, 4200.0, 2.0e6\n",
    "    Pu_kgf = Pu_kN*1000/9.80665\n",
    "    eps_y = fy_cgs/Es_cgs\n",
    "    hh = h*100\n",
    "\n",
    "    def section_force(c):\n",
    "        a = min(beta1*c, hh)\n",
    "        Cc = 0.85*fc_cgs*hh*a\n",
    "        y_Cc = edge - a/2   # 修正: 用edge(斷面邊緣), 不是half(鋼筋位置)\n",
    "        N, M = Cc, Cc*y_Cc\n",
    "        for y, n_bars in bar_layers.items():\n",
    "            As = n_bars*As_bar\n",
    "            dist = edge - y   # 修正: 用edge(斷面邊緣), 不是half(鋼筋位置)\n",
    "            eps_s = eps_cu*(c-dist)/c if c > 0 else 0.0\n",
    "            eps_s = max(min(eps_s, eps_y), -eps_y)\n",
    "            fs = Es_cgs*eps_s\n",
    "            fs_net = fs - 0.85*fc_cgs if dist <= a else fs\n",
    "            Fs = As*fs_net\n",
    "            N += Fs; M += Fs*y\n",
    "        return N, M\n",
    "\n",
    "    c_lo, c_hi = 0.01, hh*3\n",
    "    for _ in range(100):\n",
    "        c_mid = (c_lo+c_hi)/2\n",
    "        N, _ = section_force(c_mid)\n",
    "        if N > Pu_kgf:\n",
    "            c_hi = c_mid\n",
    "        else:\n",
    "            c_lo = c_mid\n",
    "    _, M_final = section_force((c_lo+c_hi)/2)\n",
    "    return M_final*9.80665e-5\n",
    "\n",
    "\n",
    "Mn_sc_147 = Mn_strain_compat(147.60)\n",
    "diff_pct = (Mn_147-Mn_sc_147)/Mn_sc_147*100\n",
    "\n",
    "print(f\"Mn(fiber, 修正後)   = {Mn_147:.2f} kN-m\")\n",
    "print(f\"Mn(應變相容法, 座標基準已修正見VL-11) = {Mn_sc_147:.2f} kN-m\")\n",
    "print(f\"差異 = {diff_pct:+.1f}%\")\n",
    "\n",
    "assert abs(diff_pct) < 20, \"差異應該在合理範圍內(20%以內), 否則代表還有問題\"\n",
    "print(f\"\\n[PASS] 差異在合理範圍內, 方向為fiber較高(應變相容法保守)\")\n",
    "print(\"解讀: Concrete01容許的極限應變(0.006)是規範簡化值(0.003)的兩倍,\")\n",
    "print(\"加上Steel02有應變硬化(規範簡化沒有納入), 兩者都讓纖維模型算出更高強度。\")\n",
    "print(\"這個方向合理: 規範簡化方法本來就該是保守估計, 不是精確值。\")\n",
    "print(\"\\n[VL-11參照] 修正座標基準後的結果, 用design_column_PM()跟獨立第三方\")\n",
    "print(\"concreteproperties交叉驗證過, 三者在Pu=147.6kN這點應該互相吻合在5%內\")"
   ]
